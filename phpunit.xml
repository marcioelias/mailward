<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            The suite runs against real MySQL and real PostgreSQL, not SQLite.
            The driver divergences between the two schema files iRedMail ships
            are precisely what would otherwise ship broken
            (docs/01-architecture.md §8, docs/reference/schema-type-matrix.md).

            These are not forced, so the shell wins: composer test:mysql and
            composer test:pgsql select the matrix cell. Run ./scripts/dev-databases.sh
            once to create the databases.
        -->
        <env name="DB_CONNECTION" value="mailward"/>
        <env name="DB_DRIVER" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="mailward_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>

        <env name="VMAIL_DB_DRIVER" value="mysql"/>
        <env name="VMAIL_DB_HOST" value="127.0.0.1"/>
        <env name="VMAIL_DB_PORT" value="3306"/>
        <env name="VMAIL_DB_DATABASE" value="vmail_test"/>
        <env name="VMAIL_DB_USERNAME" value="root"/>
        <env name="VMAIL_DB_PASSWORD" value=""/>
        <env name="VMAIL_DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
