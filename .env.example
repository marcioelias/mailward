APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Mailward's own database. Owned outright — this is where migrations run.
# Driver may be pgsql or mysql; it has nothing to do with iRedMail's backend.
DB_CONNECTION=mailward
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mailward
DB_USERNAME=mailward
DB_PASSWORD=

# iRedMail's account database. DML only — never migrated, never altered.
# Grant this user SELECT, INSERT, UPDATE, DELETE and nothing else, so the
# boundary is enforced by the server rather than by our discipline.
# VMAIL_DB_DRIVER must match the backend iRedMail was installed with:
# mysql, mariadb or pgsql. OpenLDAP installs are not supported.
VMAIL_DB_DRIVER=pgsql
VMAIL_DB_HOST=127.0.0.1
VMAIL_DB_PORT=5432
VMAIL_DB_DATABASE=vmail
VMAIL_DB_USERNAME=mailward
VMAIL_DB_PASSWORD=

# The scheme Mailward generates when it writes a mail password. It must match
# what the mail server accepts, because Dovecot reads the same column.
# Every supported scheme is always verifiable whatever this is set to; only
# generation is chosen here. A current iRedMail generates SSHA512 on Linux and
# BLF-CRYPT on the BSDs.
MAILWARD_PASSWORD_SCHEME=SSHA512

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
